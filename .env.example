# Absolute site origin for Open Graph URLs. Leave unset locally; Next uses the request host.
# NEXT_PUBLIC_SITE_URL=https://rastabaaz.example
ADMIN_KEY=
RASTABAAZ_TABLE_NAME=
AWS_REGION=ap-south-1
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# Local only, no AWS and no Docker: keep records in dev-server memory (ignored in production).
# RASTABAAZ_REPO=memory
# AWS_PROFILE=
# Ward money briefs. Without a key the ward page uses a plain template summary.
ANTHROPIC_API_KEY=
# Contractor scorecard summaries are written by Claude only (no template). Cheapest model by default.
# RUPEE_CONTRACTOR_MODEL=claude-haiku-5-5
