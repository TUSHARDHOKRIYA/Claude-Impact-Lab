# Absolute site origin for Open Graph URLs. Leave unset locally; Next uses the request host.
# NEXT_PUBLIC_SITE_URL=https://rastabaaz.example
ADMIN_KEY=
RASTABAAZ_TABLE_NAME=
AWS_REGION=ap-south-1
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
# Local only, no AWS and no Docker: keep records in dev-server memory (ignored in production).
# RASTABAAZ_REPO=memory
# AWS_PROFILE=
# Voice UI is off. Set to 1 to offer the microphone on the report form.
# The server action, tool contract and tests stay in place either way.
NEXT_PUBLIC_VOICE_UI=
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
VOICE_LLM_BASE_URL=https://api.sarvam.ai/v1
VOICE_LLM_MODEL=sarvam-105b-conversations
VOICE_LLM_KEY_NAME=SARVAM_API_KEY
# Ward money briefs. Without a key the ward page uses a plain template summary.
ANTHROPIC_API_KEY=
# RUPEE_BRIEF_MODEL=claude-opus-5-5
